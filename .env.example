# --- Server ---
PORT=3000

# Signs dashboard login session cookies. Change this to a long random
# string; anyone with it can forge a logged-in session.
SESSION_SECRET=change-me-to-a-different-long-random-string

# Widens the session cookie to cover the bare domain and every subdomain
# (e.g. ".calltrove.com" covers both calltrove.com and app.calltrove.com).
# Without this, a session created on one host is invisible on the other --
# breaks anything that redirects across hosts, like the GHL OAuth callback
# (its redirect_uri is pinned to one specific host). Leave unset locally.
COOKIE_DOMAIN=

# --- Database (Postgres) ---
# Local dev default matches docker-compose.yml. Point this at RDS later.
DATABASE_URL=postgres://vault:vault@localhost:5432/call_recording_vault
# RDS requires SSL by default. Set to "require" when DATABASE_URL points at RDS,
# leave unset for local/docker-compose Postgres (which doesn't speak SSL).
PGSSLMODE=

# --- Recording storage ---
# "local" (default) writes files under STORAGE_LOCAL_DIR.
# "s3" uploads to S3_BUCKET using the standard AWS SDK credential chain.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/recordings

S3_BUCKET=
S3_REGION=us-east-1

# --- GHL API (required -- this is how calls are ingested) ---
# Call ingestion polls GHL's own Conversations API on a timer instead of
# relying on a GHL workflow/webhook (GHL's "Call Completed" trigger has no
# recording-URL field at all, and requires manual per-account setup this
# approach avoids entirely -- see src/poller.js). Also used to fetch the
# account's real timezone so call timestamps display correctly. Generate a
# Private Integration token in the sub-account: Settings -> Private
# Integrations -> Create, with these scopes: conversations.readonly,
# conversations/message.readonly, locations.readonly, users.readonly, and
# contacts.write (only needed if CALL_SUMMARY_ENABLED below is turned on --
# it's what lets CallTrove post the AI call summary as a contact note).
# GHL_LOCATION_ID is the sub-account's location ID (visible in the browser
# URL or Settings -> Business Info). Without these set, no calls will be
# ingested at all.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# --- Call transcription (optional) ---
# Undercuts both GHL's own call transcription fee ($0.039/min) and Twilio's
# recording storage fee by a wide margin -- see src/transcription.js for the
# cost/vendor reasoning (AWS Transcribe over a cheaper option like Deepgram,
# traded for a self-serve AWS BAA instead of a sales-negotiated one).
# AWS Transcribe only reads audio from S3, so S3_BUCKET/S3_REGION above must
# be set even if STORAGE_DRIVER=local -- transcription uses S3 as a
# transient scratch space regardless of where recordings are permanently
# stored, and cleans that copy up once the transcript is retrieved.
TRANSCRIPTION_ENABLED=false
TRANSCRIBE_LANGUAGE_CODE=en-US

# --- Call summary + analytics (optional, requires TRANSCRIPTION_ENABLED) ---
# Runs each completed transcript through Claude on Amazon Bedrock (not the
# direct Anthropic API -- Bedrock is covered under AWS's own BAA, so PHI
# in a transcript never leaves AWS's compliance boundary) to produce a
# short summary (posted as a GHL contact note, requires the contacts.write
# scope above) plus structured analytics (sentiment, outcome, topics) --
# see src/callSummary.js. BEDROCK_MODEL_ID must be the exact inference
# profile ID copied from the model's page in the Bedrock console (Model
# catalog -> the model -> "Cross-region inference"), not a bare
# foundation-model ID -- current Claude models on Bedrock are cross-region
# only, so there's no plausible default to fill in here.
CALL_SUMMARY_ENABLED=false
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

# --- Email OTP (optional, self-service MFA add-on -- see src/email.js) ---
# A second self-service MFA method alongside authenticator-app TOTP; a user
# can enable one or the other, never both at once (see db/schema.sql's
# comment on users.email_otp_enabled). Uses Resend instead of Amazon SES --
# SES's production-access request was denied with no actionable reason
# given, leaving it stuck in sandbox mode (verified recipients only), which
# can't support real user logins. Resend's free tier (3,000 emails/month,
# 100/day) works for real recipients immediately; move to a paid Resend
# plan (removes the 100/day cap) once real usage approaches that ceiling.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="CallTrove <otp@notify.calltrove.com>"

# --- Ops alerting (optional -- see src/alerting.js) ---
# Where failure/recovery emails go when a background job (call ingestion,
# transcription, call summary, analytics digest) fails 3 times in a row,
# or scripts/app-watchdog.sh's external check finds the app itself
# unreachable. Reuses RESEND_API_KEY/EMAIL_FROM_ADDRESS above -- no
# separate email config. Leave blank to disable alerting entirely
# (failures still get logged, just never emailed).
ALERT_EMAIL_TO=
