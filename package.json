{
  "name": "calltrove",
  "version": "0.1.0",
  "description": "GHL call recording capture pipeline: webhook ingestion, recording storage, and per-contact call history dashboard",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "backfill": "node src/backfill.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.626.0",
    "@aws-sdk/client-ses": "^3.1140.0",
    "@aws-sdk/client-transcribe": "^3.626.0",
    "@aws-sdk/s3-request-presigner": "^3.626.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "music-metadata": "^11.16.0",
    "node-id3": "^0.2.6",
    "pg": "^8.12.0",
    "qrcode-generator": "^2.0.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  }
}
